{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "vite/client", "vitest/globals"],
    "paths": { "@notifications": ["./src/notifications/Notifications.tsx"] }
  },
  "include": ["src", "fixtures", "tests", "vite.config.ts", "vitest.config.ts"]
}
